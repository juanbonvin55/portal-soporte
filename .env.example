# Copiá este archivo como .env y completá ambos valores.
# ADMIN_PASSWORD: contraseña del panel /admin (mínimo 14 caracteres).
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA_Y_UNICA

# SESSION_SECRET: secreto aleatorio de al menos 32 caracteres.
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

PORT=3000
NODE_ENV=development

# Solo si el servidor está detrás de un proxy inverso confiable.
TRUST_PROXY=false
